// Lento grammar (pest)
//
// Design foundation (see ../ideas/grammar_and_memory.md):
//   - Declarations and expressions are separate grammatical contexts.
//   - A binding is introduced once by an anchor keyword: `spec`, `let`, `fn`, `type`.
//   - `spec` is a persistent local signature/contract; `fn` contributes function
//     clauses; `let` binds an expression; `=` is the sole assignment/mutation op.
//   - Function LHS is parsed as patterns (never as application). Application exists
//     only in expression grammar.
//   - `all a :: Ord.` quantifies type variables; `where` refines a whole signature.
//   - Memory: `T` is logical value semantics; `ref T` shared borrow (inferred);
//     `mut T` explicit exclusive mutable place; `ref x` materializes a borrow.

WHITESPACE            = _{ " " | "\t" | "\r" }
COMMENT               = _{ multiline_comment | singleline_comment }
multiline_comment     = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
singleline_comment    = _{ "//" ~ (!NEWLINE ~ ANY)* ~ (NEWLINE | EOI) }
statement_sep         = _{ (";" ~ NEWLINE*) | NEWLINE+ | &EOI }

// --------------------------------------------------------------------------
// Lexical atoms
// --------------------------------------------------------------------------

identifier_char_start  = { ASCII_ALPHA | "_" }
identifier_char        = { ASCII_ALPHA | ASCII_DIGIT | "_" }
identifier             = @{ identifier_char_start ~ identifier_char* }
integer                = @{ ASCII_DIGIT+ }
float                  = @{ integer ~ "." ~ integer }
number                 = _{ float | integer }
boolean                = @{ "true" | "false" }
escaped_char           = _{ "\\" ~ ("n" | "r" | "t" | "0" | "\\" | "\"" | "'") }
string_inner           = @{ (!"\"" ~ ANY)* }
string               = { "\"" ~ string_inner ~ "\"" }

// --------------------------------------------------------------------------
// Program / declaration structure
// --------------------------------------------------------------------------

program        = { SOI ~ (statement ~ statement_sep)* ~ EOI }
body           = { NEWLINE* ~ ((statement ~ statement_sep)* ~ statement?)? ~ NEWLINE* }
block          = { "{" ~ body ~ "}" }

statement      = _{ declaration | expression }

declaration    = _{ class_decl | impl_decl | spec_decl | type_decl | let_decl | fn_clause }

// A class is a named scope of required ordinary specs. Its type parameters
// may be proper types or higher-kinded constructors; kinds are inferred later.
class_decl     = { "class" ~ identifier ~ type_param* ~ "{" ~ NEWLINE* ~ (spec_decl ~ class_member_sep)* ~ NEWLINE* ~ "}" }

// An implementation explicitly associates a class with a type or type
// constructor and supplies ordinary function definitions for its specs.
impl_decl      = { "impl" ~ identifier ~ impl_target? ~ "{" ~ NEWLINE* ~ (fn_clause ~ class_member_sep)* ~ NEWLINE* ~ "}" }
impl_target    = { type_atom+ }
class_member_sep = _{ (";" ~ NEWLINE*) | NEWLINE+ | &"}" }

// `spec name : spec_type`
spec_decl      = { "spec" ~ identifier ~ ":" ~ spec_type }

// `type name params* = <type>` — the right-hand side is either a plain type
// (a synonym), a `[alt | alt]` sum, or an unbracketed alternation
// `alt | alt` (general sums: `int | str`; constructor sums: `Some a | None`).
// In unbracketed alternations an uppercase identifier is always a
// constructor; use the bracketed form for applied types as alternatives.
type_decl      = { "type" ~ identifier ~ type_param* ~ "=" ~ ltype ~ ty_alt* }
ty_alt         = { "|" ~ NEWLINE* ~ ltype }
type_param     = @{ type_var }

// `let [mut] pattern [: type]  = expression`
let_decl       = { "let" ~ let_mut? ~ pattern ~ (":" ~ ltype)? ~ "=" ~ expression }
let_mut        = { "mut" }

// `fn name function_pattern* [-> type] = expression`
// or `fn name function_pattern* [-> type] { ... }`
fn_clause      = { "fn" ~ identifier ~ function_pattern* ~ ("->" ~ ltype)? ~ ("=" ~ expression | block) }

function_pattern  = { pattern }

// --------------------------------------------------------------------------
// Spec types
// --------------------------------------------------------------------------

spec_type  = _{ NEWLINE* ~ (quantifier* ~ arrow_type ~ where_clause?) }

quantifier   = { "all" ~ type_var ~ ("," ~ NEWLINE* ~ type_var)* ~ constraints? ~ "." ~ NEWLINE* }
type_var     = @{ ASCII_ALPHA_LOWER ~ (ASCII_ALPHA | ASCII_DIGIT | "_")* }
constraints  = { ("::" | ":") ~ constraint ~ (("," | "+") ~ constraint)* }
constraint   = { identifier ~ type_atom* }

// Conditions are comma-separated and terminated by the newline: a `where`
// clause never reaches across a line break (a newline without a preceding
// comma ends the clause), so it cannot absorb a following declaration
// (e.g. `fn divide ...` on the next line). A comma may sit at end-of-line
// with the next condition starting on the following line.
where_clause  = { NEWLINE* ~ "where" ~ NEWLINE* ~ expression ~ ("," ~ NEWLINE* ~ expression)* }

// Types are right-associative function arrows.
ltype        = _{ arrow_type }
arrow_type   = { type_domain ~ (NEWLINE* ~ "->" ~ NEWLINE* ~ arrow_type)? }
type_domain  = _{ named_binder | type_atom }
named_binder = { "(" ~ identifier ~ ":" ~ type_atom ~ ")" }

type_atom    = _{ ty_ref | ty_mut | type_base }
ty_ref       = { "ref" ~ type_atom }
ty_mut       = { "mut" ~ type_atom }
// Sum types `[int | str]` require at least one `|`, so `[T]` stays a list
// type. A sum alternative is either an uppercase constructor `Name payload`
// or a bare type. Record types `{ a: int, b: bool }` list named fields.
type_base    = {
      ty_sum
    | identifier ~ type_args? ~ ty_app_args?
    | "(" ~ NEWLINE* ~ arrow_type? ~ NEWLINE* ~ ")"
    | "[" ~ type_atom ~ "]"
    | ty_record
}
type_args    = { "<" ~ type_atom ~ ("," ~ type_atom)* ~ ">" }
ty_app_args  = { type_atom+ }
ty_sum       = {
    "[" ~ NEWLINE* ~ sum_alternative
        ~ (NEWLINE* ~ "|" ~ NEWLINE* ~ sum_alternative)+
        ~ NEWLINE* ~ "]"
}
sum_alternative = _{ sum_ctor_alt | type_atom }
sum_ctor_alt    = { constructor_name ~ type_atom }
constructor_name = @{ 'A'..'Z' ~ (ASCII_ALPHA | ASCII_DIGIT | "_")* }
ty_record       = {
    "{" ~ NEWLINE* ~ (ty_record_field ~ ("," ~ NEWLINE* ~ ty_record_field)*)? ~ NEWLINE* ~ "}"
}
ty_record_field = { identifier ~ ":" ~ type_atom }

// --------------------------------------------------------------------------
// Patterns (left-value shapes: used in `let`, function params, lambda params,
// and match arms). A pattern is a single atom or a destructuring whose parts
// may carry optional type annotations `(x : Int)`.
// --------------------------------------------------------------------------

pattern         = { pattern_alt }
pattern_alt     = {
      "(" ~ pattern_elem ~ ("," ~ pattern_elem)+ ~ ")"   // tuple destructure: (a, b)
    | "(" ~ pattern ~ ":" ~ ltype ~ ")"                  // single annotated: (x : Int)
    | atom_pattern
    | "(" ~ pattern ~ ")"                                // grouped: (a)
}
// `boolean` must precede `identifier`: otherwise `true`/`false` parse as
// variable patterns and the first literal arm always wins.
atom_pattern    = _{ constructor_pattern | literal_pattern | identifier | "_" | list_pattern | record_pattern }
// `Some x` — an uppercase constructor applied to one payload pattern. Bare
// uppercase names (`None`) stay identifier patterns and are resolved against
// the constructor table at check/eval time.
constructor_pattern = { constructor_name ~ ctor_payload }
ctor_payload        = _{ pattern }
literal_pattern = _{ boolean | number | string }
pattern_elem    = { pattern ~ (":" ~ ltype)? }             // tuple element, optionally annotated
list_pattern    = { "[" ~ (pattern ~ ("," ~ pattern)* ~ ("," ~ spread_pattern)? | spread_pattern)? ~ "]" }
spread_pattern  = { "..." ~ identifier }
record_pattern  = { "{" ~ (record_field ~ ("," ~ record_field)* ~ ("," ~ spread_pattern)? | spread_pattern)? ~ "}" }
record_field    = { identifier ~ ":" ~ pattern }

// --------------------------------------------------------------------------
// Expressions (application only here; `fn` LHS is never parsed as application)
// --------------------------------------------------------------------------

expression     = _{ assignment | lambda_expr | binop_expr }

// `=` mutation: place := value
assignment     = { place_expr ~ "=" ~ expression }
place_expr     = { applicative }

lambda_expr    = { lambda_pattern+ ~ "=>" ~ expression }
lambda_pattern = { pattern }

binop_expr     = { applicative ~ (infix_op ~ applicative)* }
match_scrutinee = { match_applicative ~ (infix_op ~ match_applicative)* }
infix_op       = @{ ("==" | "!=" | "<=" | ">=" | "&&" | "||" | "+" | "-" | "*" | "/" | "%" | "<" | ">") }

applicative    = _{ postfix+ }
match_applicative = _{ match_postfix+ }
postfix        = _{ primary ~ postfix_op* }
match_postfix  = _{ match_primary ~ postfix_op* }
postfix_op     = _{ member_access | index_access }
member_access  = { "." ~ identifier }
index_access   = { "[" ~ expression ~ "]" }

primary        = _{ literal | tuple | list | block | record_value | ref_expr | match_expr | call | identifier | "(" ~ expression ~ ")" }
match_primary  = _{ literal | tuple | list | record_value | ref_match_expr | match_expr | call | identifier | "(" ~ expression ~ ")" }
literal        = _{ boolean | number | string }
ref_expr       = { "ref" ~ expression }
ref_match_expr = { "ref" ~ match_scrutinee }

// `match scrutinee { pattern [if guard] => body, ... }` — arms must be
// separated by commas; a comma may sit at end-of-line with the next arm on
// the following line. `=>` maps a pattern to an expression exactly as
// lambdas do (`->` stays reserved for type-level use).
match_expr     = { "match" ~ NEWLINE* ~ match_scrutinee ~ NEWLINE* ~ "{" ~ NEWLINE* ~ match_arm ~ (match_arm_sep ~ match_arm)* ~ NEWLINE* ~ "}" }
match_arm      = { pattern ~ guard? ~ "=>" ~ expression }
guard          = { "if" ~ expression }
match_arm_sep  = _{ "," ~ NEWLINE* }

// `()` is the empty tuple (unit-ish); tuples need at least one comma, so a
// single parenthesized expression `(e)` is a grouped expression, which lets
// calls be passed as juxtaposed arguments: `concat "a" (to_string 1)`.
call           = { identifier ~ "(" ~ (expression ~ ("," ~ expression)*)? ~ ")" }
tuple          = { "(" ~ ")" | "(" ~ expression ~ ("," ~ expression)+ ~ ")" }
list           = { "[" ~ (expression ~ ("," ~ expression)*)? ~ "]" }

// `{ a: 1, ...r, b: 2 }` — record value literal. A bare `{}` is a block
// (empty braces), never an empty record, so records must have an entry.
record_value   = { "{" ~ (record_value_entry ~ ("," ~ record_value_entry)*)? ~ "}" }
record_value_entry = _{ record_value_field | record_value_spread }
record_value_field  = { identifier ~ ":" ~ expression }
record_value_spread = { "..." ~ expression }
