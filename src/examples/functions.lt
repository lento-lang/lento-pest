int f(int x) = x * 2 // classic mathematical styled functions
f(30) // 60

g(y, z) = y + z // Types can be inferred from function body (Given general abstraction type)

h(y, z) {
    u = y + z // Same as above but with block body
    u // Last expression is returned
}

// Functions can be passed as arguments
type Func = int -> int
apply_twice(Func f, int x) = f(f(x)) // Higher order functions
apply_twice(f, 5) // 20
