type Ordering = Less | Equal | Greater

type Option a = None | Some a

type Result e a = Ok a | Err e

type Either a b = Left a | Right b

type ControlFlow b c = Break b | Continue c

type Bound a = Unbounded | Included a | Excluded a

spec is_some : all a. Option a -> bool
fn is_some (Some _) = true
fn is_some None = false

spec is_none : all a. Option a -> bool
fn is_none (Some _) = false
fn is_none None = true

spec unwrap_or : all a. a -> Option a -> a
fn unwrap_or _ (Some value) = value
fn unwrap_or fallback None = fallback

spec map_option : all a, b. (a -> b) -> Option a -> Option b
fn map_option transform (Some value) = Some (transform value)
fn map_option _ None = None

spec is_ok : all e, a. Result e a -> bool
fn is_ok (Ok _) = true
fn is_ok (Err _) = false

spec is_err : all e, a. Result e a -> bool
fn is_err (Ok _) = false
fn is_err (Err _) = true

spec map_result : all e, a, b. (a -> b) -> Result e a -> Result e b
fn map_result transform (Ok value) = Ok (transform value)
fn map_result _ (Err error) = Err error

spec map_err : all e, f, a. (e -> f) -> Result e a -> Result f a
fn map_err _ (Ok value) = Ok value
fn map_err transform (Err error) = Err (transform error)

spec and_then_result : all e, a, b. (a -> Result e b) -> Result e a -> Result e b
fn and_then_result transform (Ok value) = transform value
fn and_then_result _ (Err error) = Err error

class Num a {
    spec abs : a -> a
}

class Ord a {
    spec compare : a -> a -> Ordering
}

class Eq a {
    spec equal : a -> a -> bool
}

class Add a {
    spec add : a -> a -> a
}

class Concat a {
    spec concat : a -> a -> a
}

class Seq a {
    spec take : int -> a -> a
    spec drop : int -> a -> a
    spec reverse : a -> a
    spec slice : int -> int -> a -> a
}

class Len e {
    spec len : e -> int
}

class Haystack h e {
    spec contains : h -> e -> bool
}

impl Num int {
    fn abs x = __int_abs x
}

impl Num float {
    fn abs x = __float_abs x
}

impl Eq int {
    fn equal x y = __int_equal x y
}

impl Eq float {
    fn equal x y = __float_equal x y
}

impl Eq bool {
    fn equal x y = __bool_equal x y
}

impl Eq str {
    fn equal x y = __str_equal x y
}

impl Add int {
    fn add x y = __int_add x y
}

impl Add float {
    fn add x y = __float_add x y
}

impl Concat str {
    fn concat x y = __str_concat x y
}

impl all a. Seq [a] {
    fn take n xs = __list_take n xs
    fn drop n xs = __list_drop n xs
    fn reverse xs = __list_reverse xs
    fn slice start stop xs = __list_slice start stop xs
}

impl Seq str {
    fn take n text = __str_take n text
    fn drop n text = __str_drop n text
    fn reverse text = __str_reverse text
    fn slice start stop text = __str_slice start stop text
}

impl all a. Len [a] {
    fn len xs = __list_len xs
}

impl Len str {
    fn len text = __str_len text
}

impl Haystack (str) (str) {
    fn contains hay needle = __str_contains hay needle
}

spec assert : bool -> unit
fn assert (value : bool) = __bool_assert value

spec to_string : int -> str
spec to_string : float -> str
spec to_string : bool -> str
spec to_string : str -> str
fn to_string value = __int_to_string value
fn to_string value = __float_to_string value
fn to_string value = __bool_to_string value
fn to_string value = __str_to_string value
