// Literal patterns: booleans, strings, and integers.
let flag = b => match b {
    true => 1,
    false => 0
}

let name = s => match s {
    "hello" => 1,
    _ => 0
}

let classify = n => match n {
    0 => "zero",
    42 => "answer",
    _ => "other"
}

let hello_len = len "hello"

assert (flag true == 1)
assert (flag false == 0)
assert (name "hello" == 1)
assert (classify 42 == "answer")
assert (classify 7 == "other")
assert (hello_len == 5)

println (flag true)
println (flag false)
print "name hello = "
println (name "hello")
print "classify 42 = "
println (classify 42)
print "classify 7 = "
println (classify 7)
print "length of hello = "
println hello_len
