// Intrinsic functions: print, println, len, and assert.
let xs = [1, 2, 3]
let pair = (10, 20)
let s = "abc"

let xs_len = len xs
let pair_len = len pair
let s_len = len s

assert (xs_len == 3)
assert (pair_len == 2)
assert (s_len == 3)
assert true

print "xs len = "
println xs_len
print "pair len = "
println pair_len
print "s len = "
println s_len
