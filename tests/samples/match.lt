// Pattern matching: cons destructuring, guards, list patterns, and
// multi-clause `fn` grouping (which desugars into a lambda + `match`).
let len = xs => match xs {
    [] => 0
    x :: xs => 1 + len xs
}

let sign = n => match n {
    n if n > 0 => 1
    n if n < 0 => 0 - 1
    _ => 0
}

fn factorial 0 = 1
fn factorial n = n * factorial (n - 1)

fn zip [] [] = []
fn zip (x :: xs) (y :: ys) = (x, y) :: zip xs ys
